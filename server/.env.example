# ── Requis ─────────────────────────────────────────────
# Clé Gemini : utilisée UNIQUEMENT par le serveur, jamais par le client.
GEMINI_API_KEY=ta_cle_gemini

# Projet Supabase (clé service_role, uniquement côté serveur).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=ta_cle_service_role

# Clé publique « anon / publishable » : lue par les pages du site via /config.
SUPABASE_ANON_KEY=ta_cle_anon

# SasPay (https://docs.saspay.me) — clé secrète, uniquement côté serveur.
# Test : sk_test_...   Production : sk_live_...
SASPAY_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXX

# Secret de signature du webhook (affiché UNE seule fois à la création du
# webhook dans app.saspay.me → Webhooks). URL à déclarer :
# https://codex-technicien.onrender.com/webhooks/saspay  (événement : transaction.success)
SASPAY_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX

# Page où SasPay renvoie le client après un paiement réussi (optionnel)
# SASPAY_RETURN_URL=https://codex-technicien.onrender.com/abonnements?retour=1

# Clé interne du serveur.
SECRET_KEY=une_cle_secrete_aleatoire

# ── Optionnel ──────────────────────────────────────────
# Clé publique « anon » du projet Supabase (renouvellement de session
# /auth/refresh). À défaut, la clé service_role sert au même usage.
# SUPABASE_ANON_KEY=

# Modèle Gemini utilisé par /chat (défaut : gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Lien de la page device affiché dans le terminal
# DARKCODEX_DEVICE_URL=https://codex-technicien.onrender.com/device

# Délai d'appel Gemini en secondes (défaut : 120)
# GEMINI_TIMEOUT_SECONDS=120

# Versions annoncées par GET /version (le défaut est la version du dépôt)
# DARKCODEX_LATEST_VERSION=2.1.0
# DARKCODEX_MIN_VERSION=0.0.0
